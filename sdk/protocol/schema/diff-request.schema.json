{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A request to display a diff between two named sides in the IDE.",
  "properties": {
    "left": {
      "type": "string"
    },
    "left_label": {
      "description": "A short label for each side (e.g. `HEAD` vs `proposed`).",
      "type": "string"
    },
    "right": {
      "type": "string"
    },
    "right_label": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "left",
    "left_label",
    "right",
    "right_label",
    "title"
  ],
  "title": "DiffRequest",
  "type": "object"
}
