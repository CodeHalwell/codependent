{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Position": {
      "description": "A zero-based position in a text document.",
      "properties": {
        "character": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "character",
        "line"
      ],
      "type": "object"
    },
    "Range": {
      "description": "A half-open range within a single document.",
      "properties": {
        "end": {
          "$ref": "#/definitions/Position"
        },
        "start": {
          "$ref": "#/definitions/Position"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    }
  },
  "description": "A point in a workspace the daemon asks the IDE to reveal.",
  "properties": {
    "path": {
      "type": "string"
    },
    "range": {
      "anyOf": [
        {
          "$ref": "#/definitions/Range"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "path"
  ],
  "title": "Location",
  "type": "object"
}
