{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Position": {
      "description": "A zero-based position in a text document.",
      "properties": {
        "character": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "character",
        "line"
      ],
      "type": "object"
    },
    "Range": {
      "description": "A half-open range within a single document.",
      "properties": {
        "end": {
          "$ref": "#/definitions/Position"
        },
        "start": {
          "$ref": "#/definitions/Position"
        }
      },
      "required": [
        "end",
        "start"
      ],
      "type": "object"
    }
  },
  "description": "A single text replacement within one document.",
  "properties": {
    "new_text": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "range": {
      "$ref": "#/definitions/Range"
    }
  },
  "required": [
    "new_text",
    "path",
    "range"
  ],
  "title": "TextEdit",
  "type": "object"
}
