{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Severity of an editor diagnostic, mirroring the common LSP levels.",
  "oneOf": [
    {
      "properties": {
        "type": {
          "enum": [
            "Error"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "enum": [
            "Warning"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "enum": [
            "Information"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "enum": [
            "Hint"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "type": {
          "enum": [
            "Unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  ],
  "title": "DiagnosticSeverity"
}
