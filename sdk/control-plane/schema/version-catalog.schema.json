{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ControlPlaneError": {
      "description": "Standard wire error response returned by all Control Plane REST APIs.",
      "properties": {
        "code": {
          "description": "Optional machine-readable sub-code.",
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "description": "Structured details for validation or debugging (sanitized of sensitive data)."
        },
        "message": {
          "description": "Human-readable error message.",
          "type": "string"
        },
        "resource": {
          "description": "Resource name if applicable (e.g. \"repository\", \"session\", \"organization\").",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "description": "Categorical error type (e.g. \"not_found\", \"unauthorized\", \"validation_error\", \"conflict\").",
          "type": "string"
        }
      },
      "required": [
        "message",
        "type"
      ],
      "type": "object"
    },
    "ProtocolHandshakeRequest": {
      "description": "Initial protocol handshake request from a client or daemon.",
      "properties": {
        "capabilities": {
          "default": [],
          "description": "Capabilities requested by the client.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "client_build_id": {
          "description": "Client build identifier if available.",
          "type": [
            "string",
            "null"
          ]
        },
        "client_kind": {
          "description": "Client identifier or kind (e.g. \"daemon\", \"web-ui\", \"cli\").",
          "type": "string"
        },
        "client_version": {
          "allOf": [
            {
              "$ref": "#/definitions/ProtocolVersion"
            }
          ],
          "description": "The client's supported protocol version."
        }
      },
      "required": [
        "client_kind",
        "client_version"
      ],
      "type": "object"
    },
    "ProtocolHandshakeResponse": {
      "description": "Server response to a protocol handshake request.",
      "properties": {
        "min_compatible_version": {
          "allOf": [
            {
              "$ref": "#/definitions/ProtocolVersion"
            }
          ],
          "description": "The oldest supported client version."
        },
        "negotiated_version": {
          "allOf": [
            {
              "$ref": "#/definitions/ProtocolVersion"
            }
          ],
          "description": "The negotiated protocol version to use for subsequent interactions."
        },
        "server_version": {
          "allOf": [
            {
              "$ref": "#/definitions/ProtocolVersion"
            }
          ],
          "description": "The server's full supported protocol version."
        },
        "supported_capabilities": {
          "default": [],
          "description": "Active capabilities negotiated for this connection.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "min_compatible_version",
        "negotiated_version",
        "server_version"
      ],
      "type": "object"
    },
    "ProtocolVersion": {
      "description": "Control plane wire protocol version.",
      "properties": {
        "major": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        },
        "minor": {
          "format": "uint16",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    }
  },
  "properties": {
    "error": {
      "$ref": "#/definitions/ControlPlaneError"
    },
    "handshake_request": {
      "$ref": "#/definitions/ProtocolHandshakeRequest"
    },
    "handshake_response": {
      "$ref": "#/definitions/ProtocolHandshakeResponse"
    },
    "version": {
      "$ref": "#/definitions/ProtocolVersion"
    }
  },
  "required": [
    "error",
    "handshake_request",
    "handshake_response",
    "version"
  ],
  "title": "VersionCatalog",
  "type": "object"
}
