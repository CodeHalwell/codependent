          "minimum": 0.0,
          "type": "integer"
        },
        "memory_mb": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "network_allowlist": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "read_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "wall_seconds": {
