{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ActionScope": {
      "description": "Explicit scope constraints for scoped grants (e.g. Approver role).",
      "properties": {
        "action_kinds": {
          "description": "Specific action types permitted (e.g. \"ExecuteCommand\", \"WriteFile\").",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "max_risk_level": {
          "description": "Maximum risk level allowed for auto-delegated approval.",
          "type": [
            "string",
            "null"
          ]
        },
        "repositories": {
          "description": "Repositories to which this approval grant is restricted.",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AuditActorKind": {
      "description": "Actor kind responsible for an audited action.",
      "oneOf": [
        {
          "enum": [
            "user",
            "daemon",
            "system"
          ],
          "type": "string"
        },
        {
          "description": "Unrecognized or newer actor kind. Retained verbatim in the hash chain so that an old reader can still verify a record written by a newer writer.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "AuditRecord": {
      "description": "Immutable audit record with tamper-evident cryptographic hash chaining.",
      "properties": {
        "action": {
          "type": "string"
        },
        "action_digest": {
          "type": "string"
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_kind": {
          "$ref": "#/definitions/AuditActorKind"
        },
        "correlation_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "default": null
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "type": "string"
        },
        "prev_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_hash": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "target_kind": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "action_digest",
        "actor_kind",
        "id",
        "occurred_at",
        "organization_id",
        "record_hash",
        "target_id",
        "target_kind"
      ],
      "type": "object"
    },
    "AuditRecordPage": {
      "description": "Standard paginated response envelope.\n\nThe schema name is `<T>Page` (e.g. `AuditRecordPage`) rather than schemars' default `Page_for_AuditRecord`, because that default becomes `PageFor_AuditRecord` in the generated TypeScript — a name no client author would type.",
      "properties": {
        "has_more": {
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/definitions/AuditRecord"
          },
          "type": "array"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_count": {
          "description": "Bounded count computed strictly inside the authorized set.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "has_more",
        "items"
      ],
      "type": "object"
    },
    "ControlPlaneRole": {
      "description": "Standard control-plane roles.\n\nOrdering is by privilege, ascending, with `Unknown` lowest — but it is implemented via [`ControlPlaneRole::privilege_rank`] rather than derived. `#[serde(other)]` must sit on the **last** variant, while the fail-closed invariant needs `Unknown` to rank **below** every named role; a derived `Ord` cannot satisfy both, and deriving it after moving `Unknown` last would silently invert the ranking into \"unknown outranks everything\".",
      "oneOf": [
        {
          "description": "Read-only access to metadata.",
          "enum": [
            "observer"
          ],
          "type": "string"
        },
        {
          "description": "Read and write access to sessions, code graph, and artifacts.",
          "enum": [
            "contributor"
          ],
          "type": "string"
        },
        {
          "description": "Authorized to grant approvals within an explicit action scope.",
          "enum": [
            "approver"
          ],
          "type": "string"
        },
        {
          "description": "Administrative control over repositories and teams within the organization.",
          "enum": [
            "maintainer"
          ],
          "type": "string"
        },
        {
          "description": "Full administrative control over the entire organization.",
          "enum": [
            "organization-admin"
          ],
          "type": "string"
        },
        {
          "description": "Unrecognized or newer role name. Ranks below every named role and `permits` denies every action for it.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "Daemon": {
      "description": "Registered daemon instance in the control plane.",
      "properties": {
        "accepts_remote_approvals": {
          "type": "boolean"
        },
        "accepts_runner_dispatch": {
          "type": "boolean"
        },
        "consent_manifest_hash": {
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "last_seen_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "max_publication_class": {
          "$ref": "#/definitions/PublicationClass"
        },
        "organization_id": {
          "format": "uuid",
          "type": "string"
        },
        "paired_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "paired_by": {
          "format": "uuid",
          "type": "string"
        },
        "revoked_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/definitions/DaemonState"
        }
      },
      "required": [
        "accepts_remote_approvals",
        "accepts_runner_dispatch",
        "consent_manifest_hash",
        "created_at",
        "display_name",
        "id",
        "max_publication_class",
        "organization_id",
        "paired_by",
        "state"
      ],
      "type": "object"
    },
    "DaemonPage": {
      "description": "Standard paginated response envelope.\n\nThe schema name is `<T>Page` (e.g. `AuditRecordPage`) rather than schemars' default `Page_for_AuditRecord`, because that default becomes `PageFor_AuditRecord` in the generated TypeScript — a name no client author would type.",
      "properties": {
        "has_more": {
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/definitions/Daemon"
          },
          "type": "array"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "total_count": {
          "description": "Bounded count computed strictly inside the authorized set.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "has_more",
        "items"
      ],
      "type": "object"
    },
    "DaemonState": {
      "description": "Lifecycle state of a paired daemon instance.",
      "oneOf": [
        {
          "enum": [
            "pending",
            "active",
            "revoked",
            "expired"
          ],
          "type": "string"
        },
        {
          "description": "Unrecognized or newer state. Never treated as active.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "DataClassification": {
      "description": "Data sensitivity classification hierarchy.",
      "oneOf": [
        {
          "description": "Publicly shareable data.",
          "enum": [
            "public"
          ],
          "type": "string"
        },
        {
          "description": "Internal organization data.",
          "enum": [
            "internal"
          ],
          "type": "string"
        },
        {
          "description": "Confidential data requiring elevated access.",
          "enum": [
            "confidential"
          ],
          "type": "string"
        },
        {
          "description": "Highly sensitive secrets and credentials.",
          "enum": [
            "secret"
          ],
          "type": "string"
        },
        {
          "description": "Unrecognized classification. Treated as at least as restrictive as Secret.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "MembershipState": {
      "description": "State of an organization membership.",
      "oneOf": [
        {
          "enum": [
            "invited",
            "active",
            "suspended"
          ],
          "type": "string"
        },
        {
          "description": "Unrecognized or newer state. Never treated as active membership.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "ObjectEncryption": {
      "description": "Encryption mode for stored objects.",
      "oneOf": [
        {
          "enum": [
            "none",
            "envelope"
          ],
          "type": "string"
        },
        {
          "description": "Unrecognized or newer encryption mode. The object must not be decrypted or served.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "ObjectState": {
      "description": "Lifecycle state of a published object in object storage.",
      "oneOf": [
        {
          "description": "Upload in-flight. Invisible to all read paths and counts until completed.",
          "enum": [
            "uploading"
          ],
          "type": "string"
        },
        {
          "description": "Upload completed and content hash verified. Visible to authorized reads.",
          "enum": [
            "available"
          ],
          "type": "string"
        },
        {
          "description": "Object tombstoned / deleted.",
          "enum": [
            "tombstoned"
          ],
          "type": "string"
        },
        {
          "description": "Unrecognized or newer state. Never served and never counted.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "OrganizationMembership": {
      "description": "Organization membership binding a user to an organization.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
