        "member_count": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "repository_count": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "slug": {
          "type": "string"
