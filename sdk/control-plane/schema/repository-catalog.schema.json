{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DataClassification": {
      "description": "Data sensitivity classification hierarchy.",
      "oneOf": [
        {
          "description": "Publicly shareable data.",
          "enum": [
            "public"
          ],
          "type": "string"
        },
        {
          "description": "Internal organization data.",
          "enum": [
            "internal"
          ],
          "type": "string"
        },
        {
          "description": "Confidential data requiring elevated access.",
          "enum": [
            "confidential"
          ],
          "type": "string"
        },
        {
          "description": "Highly sensitive secrets and credentials.",
          "enum": [
            "secret"
          ],
          "type": "string"
        },
        {
          "description": "Unrecognized classification. Treated as at least as restrictive as Secret.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "PublicationClass": {
      "description": "Publication class hierarchy. Defines how far data may be synchronized or shared.",
      "oneOf": [
        {
          "description": "Stays on the local machine only; never sent off-device.",
          "enum": [
            "private-local"
          ],
          "type": "string"
        },
        {
          "description": "Bounded operational metadata only (e.g. session counts, run states). No titles/content.",
          "enum": [
            "metadata-shared"
          ],
          "type": "string"
        },
        {
          "description": "Shared session and artifact titles and content summaries within the organization.",
          "enum": [
            "content-shared"
          ],
          "type": "string"
        },
        {
          "description": "Indexed in the shared organization knowledge graph.",
          "enum": [
            "organization-knowledge"
          ],
          "type": "string"
        },
        {
          "description": "Signed and publishable to the public marketplace.",
          "enum": [
            "public-marketplace"
          ],
          "type": "string"
        },
        {
          "description": "Unknown or newer publication class. Treated as strictly local (strictest rank).",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "RegisterRepositoryRequest": {
      "description": "Request to register a repository in an organization.",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "federated_id": {
          "type": "string"
        },
        "max_classification": {
          "anyOf": [
            {
              "$ref": "#/definitions/DataClassification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_publication_class": {
          "anyOf": [
            {
              "$ref": "#/definitions/PublicationClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "display_name",
        "federated_id"
      ],
      "type": "object"
    },
    "Repository": {
      "description": "Repository entity registered with an organization in the control plane.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "federated_id": {
          "description": "Cross-machine federated identity (SHA-256 hex).",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "max_classification": {
          "$ref": "#/definitions/DataClassification"
        },
        "max_publication_class": {
          "$ref": "#/definitions/PublicationClass"
        },
        "organization_id": {
          "format": "uuid",
          "type": "string"
        },
        "policy_version": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "created_at",
        "display_name",
        "federated_id",
        "id",
        "max_classification",
        "max_publication_class",
        "organization_id",
        "policy_version"
      ],
      "type": "object"
    },
    "RepositorySummary": {
      "description": "Compact repository summary for listings.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "federated_id": {
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "max_classification": {
          "$ref": "#/definitions/DataClassification"
        },
        "max_publication_class": {
          "$ref": "#/definitions/PublicationClass"
        },
        "organization_id": {
          "format": "uuid",
          "type": "string"
        },
        "published_object_count": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "shared_session_count": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "created_at",
        "display_name",
        "federated_id",
        "id",
        "max_classification",
        "max_publication_class",
        "organization_id",
        "published_object_count",
        "shared_session_count"
      ],
      "type": "object"
    },
    "UpdateRepositoryRequest": {
      "description": "Request to update repository settings.",
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_classification": {
          "anyOf": [
            {
              "$ref": "#/definitions/DataClassification"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_publication_class": {
          "anyOf": [
            {
              "$ref": "#/definitions/PublicationClass"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "register_request": {
      "$ref": "#/definitions/RegisterRepositoryRequest"
    },
    "repository": {
      "$ref": "#/definitions/Repository"
    },
    "summary": {
      "$ref": "#/definitions/RepositorySummary"
    },
    "update_request": {
      "$ref": "#/definitions/UpdateRepositoryRequest"
    }
  },
  "required": [
    "register_request",
    "repository",
    "summary",
    "update_request"
  ],
  "title": "RepositoryCatalog",
  "type": "object"
}
