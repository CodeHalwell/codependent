{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AuditActorKind": {
      "description": "Actor kind responsible for an audited action.",
      "oneOf": [
        {
          "enum": [
            "user",
            "daemon",
            "system"
          ],
          "type": "string"
        },
        {
          "description": "Unrecognized or newer actor kind. Retained verbatim in the hash chain so that an old reader can still verify a record written by a newer writer.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "AuditQuery": {
      "description": "Query parameters for filtering audit logs.",
      "properties": {
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_time": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "to_time": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AuditRecord": {
      "description": "Immutable audit record with tamper-evident cryptographic hash chaining.",
      "properties": {
        "action": {
          "type": "string"
        },
        "action_digest": {
          "type": "string"
        },
        "actor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor_kind": {
          "$ref": "#/definitions/AuditActorKind"
        },
        "correlation_id": {
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "default": null
        },
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "type": "string"
        },
        "prev_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_hash": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "target_kind": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "action_digest",
        "actor_kind",
        "id",
        "occurred_at",
        "organization_id",
        "record_hash",
        "target_id",
        "target_kind"
      ],
      "type": "object"
    }
  },
  "properties": {
    "actor_kind": {
      "$ref": "#/definitions/AuditActorKind"
    },
    "query": {
      "$ref": "#/definitions/AuditQuery"
    },
    "record": {
      "$ref": "#/definitions/AuditRecord"
    }
  },
  "required": [
    "actor_kind",
    "query",
    "record"
  ],
  "title": "AuditCatalog",
  "type": "object"
}
