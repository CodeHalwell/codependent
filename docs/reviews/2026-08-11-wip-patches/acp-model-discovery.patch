+/// Read `mcp.toml` at `mcp_toml` and derive the launch specs safe to forward
+/// to an external ACP agent: name + command + args only. A server declaring
+/// explicit `env` pairs is withheld entirely — those pairs are the operator's
+/// channel for secrets, and forwarding the spec without its declared
+/// environment would ship a knowingly broken launch line. Forwarding is ON by
+/// default; an `[acp] forward_mcp_servers = false` table in `mcp.toml` (a key
+/// the MCP loader itself ignores) turns it off. A missing or malformed file
+/// forwards nothing — the daemon already surfaces the parse error loudly at
+/// boot, so this stays quiet rather than double-reporting.
+#[must_use]
+pub fn forwardable_mcp_servers(mcp_toml: &std::path::Path) -> Vec<AcpMcpServer> {
+    #[derive(Default, serde::Deserialize)]
+    struct ForwardFile {
+        #[serde(default)]
+        acp: ForwardTable,
+    }
+    #[derive(serde::Deserialize)]
+    struct ForwardTable {
+        #[serde(default = "forward_default")]
+        forward_mcp_servers: bool,
+    }
+    impl Default for ForwardTable {
+        fn default() -> Self {
+            Self {
+                forward_mcp_servers: forward_default(),
+            }
+        }
+    }
+    fn forward_default() -> bool {
+        true
+    }
+
+    let Ok(config) = crate::mcp::load_mcp_config(mcp_toml) else {
+        return Vec::new();
+    };
+    let forward = std::fs::read_to_string(mcp_toml)
+        .ok()
+        .and_then(|text| toml::from_str::<ForwardFile>(&text).ok())
+        .is_none_or(|file| file.acp.forward_mcp_servers);
+    if !forward {
+        return Vec::new();
+    }
+    config
+        .servers
+        .into_iter()
+        .filter(|server| server.env.is_empty())
+        .map(|server| AcpMcpServer {
+            name: server.name,
+            command: server.command,
+            args: server.args,
+        })
+        .collect()
+}
+
+/// What the handshake taught us about the agent, shared between the connection
+/// driver (which populates it before signalling ready and refreshes it on
+/// `ConfigOptionUpdate` / `set_config_option` responses) and the
+/// [`AcpClient`]'s accessors.
+#[derive(Debug, Clone, Default)]
+struct AcpDiscovery {
+    auth_methods: Vec<AcpAuthMethod>,
+    models: Vec<AcpModel>,
+    modes: Vec<AcpMode>,
+    /// The `SessionConfigId` of the Model-category selector, kept so
+    /// [`AcpClient::set_model`] can target it.
+    model_config_id: Option<String>,
+    /// Whether `modes` came from the response's dedicated `modes` state (the
+    /// richer source); a Mode-category config option never overwrites it then.
+    modes_from_state: bool,
+}
+
+impl AcpDiscovery {
+    fn apply_initialize(&mut self, response: &InitializeResponse) {
+        self.auth_methods = response
+            .auth_methods
+            .iter()
+            .map(|method| AcpAuthMethod {
+                id: method.id().to_string(),
+                name: method.name().to_string(),
+                description: method.description().map(str::to_string),
+            })
+            .collect();
+    }
+
+    fn apply_session(&mut self, response: &NewSessionResponse) {
+        if let Some(state) = &response.modes {
+            self.modes_from_state = true;
+            let current = state.current_mode_id.to_string();
+            self.modes = state
+                .available_modes
+                .iter()
+                .map(|mode| AcpMode {
+                    current: mode.id.to_string() == current,
+                    id: mode.id.to_string(),
+                    name: mode.name.clone(),
+                })
+                .collect();
+        }
+        if let Some(options) = &response.config_options {
+            self.apply_config_options(options);
+        }
+    }
+
+    /// Fold a full config-option set (from `session/new`, a
+    /// `set_config_option` response, or a `ConfigOptionUpdate`) into the
+    /// discovery state. Every arrival carries the complete current set, so
+    /// Model/Mode selectors are replaced, never merged.
+    fn apply_config_options(&mut self, options: &[SessionConfigOption]) {
+        for option in options {
+            let SessionConfigKind::Select(select) = &option.kind else {
+                continue;
+            };
+            let current = select.current_value.to_string();
+            match option.category {
+                Some(SessionConfigOptionCategory::Model) => {
+                    self.model_config_id = Some(option.id.to_string());
+                    self.models = select_entries(select)
+                        .into_iter()
+                        .map(|(id, name)| AcpModel {
+                            current: id == current,
+                            id,
+                            name,
+                        })
+                        .collect();
+                }
+                Some(SessionConfigOptionCategory::Mode) if !self.modes_from_state => {
+                    self.modes = select_entries(select)
+                        .into_iter()
+                        .map(|(id, name)| AcpMode {
+                            current: id == current,
+                            id,
+                            name,
+                        })
+                        .collect();
+                }
+                // ModelConfig/ThoughtLevel/unknown categories (the enum is
+                // `#[non_exhaustive]`) are not model discovery.
+                _ => {}
+            }
+        }
+    }
+
+    fn apply_current_mode(&mut self, mode_id: &str) {
+        for mode in &mut self.modes {
+            mode.current = mode.id == mode_id;
+        }
+    }
+}
