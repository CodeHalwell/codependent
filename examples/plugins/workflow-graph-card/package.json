{
  "name": "workflow-graph-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/worker.tsx --bundle --platform=node --format=esm --target=node22 --outfile=dist/worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "codypendent-ui dev",
    "validate": "codypendent-ui validate",
    "package": "codypendent-ui package"
  },
  "dependencies": {
    "@codypendent/ui": "file:../../../sdk/ui",
    "react": "19.0.0",
    "react-reconciler": "0.31.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "19.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13"
  }
}
